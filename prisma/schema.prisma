// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Donation {
  id                  String               @id
  status              String
  createdAt           DateTime
  completedAt         DateTime?
  desc                String?
  shopifyOrderId      String?              // blank for orders that never reached Shopify (e.g. still open)
  deliveryMethod      String?              // "pickup" | "courier" | "unknown"
  recipient           User                 @relation(fields: [recipientId], references: [id])
  recipientId         String
  entries             DonationEntry[]
}

model User {
  id          String     @id @default(cuid())
  name        String     // organization name from recipient_org (e.g. "Regional Community Vet Clinic")
  type        String?    // recipient_type from source data (e.g. "wildlife_rescue")
  contactName String?
  email       String?    @unique // not present in the current source data
  street      String?
  city        String?
  zip         String?
  state       String?
  country     String?
  lat         Float?
  lng         Float?
  phone       String?
  donations   Donation[]
}

model DonatedItem {
  id               String          @id @default(cuid()) // import uses item_key from source data (e.g. "syringe-pump-infuser")
  name             String          // display_name from source data
  sku              String?
  category         String?
  unitsPerPack     Int?
  unitWeightKg     Float?
  weightSource     String?
  co2eKgPerUnit    Float?
  co2eSource       String?
  healthImpactTier Int?
  entries          DonationEntry[]
}

model DonationEntry {
  id           String        @id @default(cuid()) // import uses "<order_id>-<line_no>" (e.g. "D5-1")
  donation     Donation      @relation(fields: [donationId], references: [id])
  donationId   String
  item         DonatedItem   @relation(fields: [itemId], references: [id])
  itemId       String
  lineNo       Int?
  variant      String?       // e.g. "Top / Black / XS"
  quantity     Int
}
