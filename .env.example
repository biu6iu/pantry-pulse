# Postgres connection via a pooler (transaction mode), used at runtime
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"

# Direct (non-pooled) Postgres connection, used by the Prisma CLI for migrations
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Postgres connection used by tests (tests/global-setup.ts runs migrate deploy against this)
TEST_DATABASE_URL="postgresql://user:password@host:5432/test_dbname"
